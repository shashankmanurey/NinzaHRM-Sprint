<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross-Browser-Suite" parallel="false">

    <test name="Chrome-Test">
        <parameter name="browser" value="chrome"/>
        <classes>
	      <class name="LoginScript.LoginPositive"/>
	      <class name="DashboardScript.DashboardPositive"/>
	      <class name="EmployeeScript.EmployeePositive"/>
	      <class name="EmployeeScript.EmployeeNegative"/>
	      <class name="LoginScript.LoginNegative"/>
	      <class name="DashboardScript.DashboardNegative"/>
        </classes>
    </test>

